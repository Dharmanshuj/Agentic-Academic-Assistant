# Spring Boot service configuration
DB_HOST=your-neon-host
DB_PORT=5432
DB_NAME=nitj_student_assistant
DB_USER=your-neon-user
DB_PASS=replace-with-your-neon-password
FRONTEND_ORIGINS=http://localhost:3000
# Must match the SECRET_KEY used by the FastAPI service — it verifies JWTs FastAPI signs.
SECRET_KEY=replace-with-a-long-random-secret
